{
  /* 타입체크 전용 — 번들은 esbuild 가 만든다 (npm run build:js).
     그래서 noEmit 이고 outFile/outDir 이 없다. */
  "compilerOptions": {
    /* 출력/환경 */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "noEmit": true,

    /* 타입 체크 정책 — 현행 유지. strict 도입은 ROADMAP P1-B */
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,

    /* 레거시/ESM 혼용 대응 */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "noEmitOnError": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "scripts"]
}
